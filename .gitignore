# 环境变量与机密配置（严禁提交）
.env
.env.local
.env.*.local

# 数据库持久化文件（包含运行隐私，严禁提交）
*.sqlite3
*.db
db.sqlite3

# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.class
.venv/
env/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# 前端构建产物与依赖
node_modules/
dist/
.vite/
*.tsbuildinfo

# 日志与进程锁文件
logs/
*.log
*.err
*.pid
.temp/
_patches/
.DS_Store
Thumbs.db

# 运行时状态与临时引导脚本
.run/
.run_mode
frontend/start_vite.mjs

# 静态目录下的图片副本由构建流程处理，避免与 frontend/public 重复推送到 GitHub
static/fetal-stories/

# 严禁将 SSL 证书与私钥推送到 GitHub
*.key
*.pem
*.crt
*.pfx
*.p12
nginx/ssl/*
!nginx/ssl/.gitkeep

# 严禁将 IDE 配置推送到 GitHub
.idea/
.vscode/
*.swp
*~
*.bak
