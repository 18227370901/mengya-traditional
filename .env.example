# ===== Django =====
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,*

# ===== 数据库配置（传统版严格默认采用本地 SQLite，与 Docker 版数据 100% 物理隔离）=====
# 默认存储模式：无需任何配置，数据自动存储于本地独立文件 mengya-local/db.sqlite3
# 若明确需要连接外部 PostgreSQL（非默认），需同时开启并配置以下两项：
# USE_POSTGRES=True
# DATABASE_URL=postgresql://mengya:mengya123@127.0.0.1:5432/mengya

# ===== Redis 缓存 / Celery（本地无 Redis 时自动降级 eager，无需配置）=====
# REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT =====
JWT_SECRET_KEY=change-me-in-production

# ===== AI (可选，不配置则使用内置本地回复引擎) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ===== 电商 CPS（预留，暂不影响运行）=====
TAOBAO_APP_KEY=
JD_APP_KEY=
PDD_APP_KEY=

# ===== Celery 队列（可选）=====
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
