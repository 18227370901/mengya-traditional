# ===== 数据库部署模式 (支持交互式选择，定时任务自动记忆免交互) =====
# DB_MODE 可选值:
#   sqlite:    本地化单文件 SQLite (默认推荐，db.sqlite3，与 Docker 版数据 100% 物理隔离)
#   shared:    共享宿主机已在运行的 PG 容器 (如 pgvector-18，自动创建专属库 mengya_local 与账号，零多余容器)
#   dedicated: 独立专属 PostgreSQL 容器 (${APP_NAME}-pg，默认复用本地 PG 镜像)
DB_MODE=sqlite
APP_NAME=mengya_local
SHARED_PG_CONTAINER=pgvector-18

# ===== 数据库连接配置 =====
USE_POSTGRES=False
DATABASE_URL=
DB_IMAGE=pgvector/pgvector:pg18
DB_PULL_POLICY=never

# ===== Django =====
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,*

# ===== JWT =====
JWT_SECRET_KEY=change-me-in-production

# ===== AI (可选，不配置则使用内置本地回复引擎) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ===== 电商 CPS（预留，暂不影响运行）=====
TAOBAO_APP_KEY=
JD_APP_KEY=
PDD_APP_KEY=

# ===== Celery 队列（可选）=====
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
